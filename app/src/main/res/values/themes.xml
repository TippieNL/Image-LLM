<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UnfilteredStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/charcoal</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.UnfilteredStudio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/charcoal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.UnfilteredStudio</item>
    </style>
</resources>
